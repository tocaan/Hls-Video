{
  "name": "tocaan/hls-videos",
  "description": "Upload videos, convert them to HLS streams with FFmpeg, and serve them from S3-compatible storage.",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "HlsVideos\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "HlsVideos\\Providers\\HlsVideoServiceProvider"
      ]
    }
  },
  "require": {
    "php": "^8.1",
    "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
    "pbmedia/laravel-ffmpeg": "^8.3",
    "pion/laravel-chunk-upload": "^1.5"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
